# Copy to .env (git-ignored) and uncomment what you need. Real environment variables win over this file.
# FLEET_PORT=8930                 # default 8930
# FLEET_HOST=127.0.0.1            # loopback only; any other value is refused
# FLEET_DATA_DIR=./data           # where fleet.db lives
# FLEET_CACHE_DIR=./.cache        # token, prompts, logs, memory backups
# FLEET_CTX_LIMIT=150000          # rotate a bot's conversation above this many context tokens
# FLEET_ROUTER_MODEL=haiku        # model for the router (claude -p --model)
# FLEET_SESSIONS=1                # optional: show your interactive Claude Code sessions as extra cats (read-only)

# Optional completion push via Telegram (plain text). Disabled unless BOTH are set:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# FLEET_TG_NOTIFY=0               # set 0 to switch the push off again without removing the two lines above
